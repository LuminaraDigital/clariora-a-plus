# ==============================================================================
# Clariora A+ - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before deploying or running administrative tasks.
# NEVER commit .env or actual production credentials to version control.
#
# All variables marked [REQUIRED] must be defined for full edge deployment
# and API worker operations.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloudflare Core & Edge Infrastructure
# ------------------------------------------------------------------------------

# [REQUIRED] Cloudflare API Token
# Permissions required:
#   - Account: Workers Scripts:Edit, D1:Edit, Pages:Edit
#   - Zone: Cache Purge:Purge, Zone:Read, DNS:Edit
# Obtain from: Cloudflare Dashboard -> My Profile -> API Tokens -> Create Token
# Format: 40-character alphanumeric string (e.g., cfat_... or standard token)
CLOUDFLARE_API_TOKEN=

# [REQUIRED] Cloudflare Account ID
# The 32-character hex identifier for your Cloudflare organization or account.
# Obtain from: Cloudflare Dashboard -> Workers & Pages -> Overview (Right sidebar)
CLOUDFLARE_ACCOUNT_ID=

# [REQUIRED] Cloudflare Zone ID
# The 32-character hex identifier for the authoritative DNS zone (e.g., clariora.com.au).
# Obtain from: Cloudflare Dashboard -> Select domain -> Overview (Right sidebar)
CLOUDFLARE_ZONE_ID=

# ------------------------------------------------------------------------------
# 2. Cloudflare R2 Object Storage (Media Assets & Exam Shards)
# ------------------------------------------------------------------------------

# [REQUIRED] R2 S3-Compatible Access Key ID
# The 32-character hex access key identifier for Cloudflare R2 bucket access.
# Obtain from: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCESS_KEY_ID=

# [REQUIRED] R2 S3-Compatible Secret Access Key
# The 64-character hex secret access key for Cloudflare R2.
# Obtain from: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_SECRET_ACCESS_KEY=

# [REQUIRED] R2 S3 Endpoint URL
# Format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Replace <ACCOUNT_ID> with your 32-character CLOUDFLARE_ACCOUNT_ID.
R2_ENDPOINT=

# ------------------------------------------------------------------------------
# 3. Administrative Security & Edge API Authentication
# ------------------------------------------------------------------------------

# [REQUIRED] Admin API Key
# High-entropy pre-shared secret (minimum 32 bytes / 64 hex characters) used
# to authenticate administrative API calls (e.g., GET /api/v1/auth/accounts
# and access to /admin/users.html).
# Generate using: openssl rand -hex 32
ADMIN_API_KEY=

# ------------------------------------------------------------------------------
# 4. Telegram Bot & Mini App (TMA) Integration
# ------------------------------------------------------------------------------

# [REQUIRED] Telegram Bot Token
# Token issued by @BotFather upon bot creation. Used for verifying client
# initData HMAC signatures and issuing Telegram Stars invoices.
# Format: <bot_id>:<alphanumeric_secret> (e.g., 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=

# [REQUIRED] Web Application Public Target URL
# Canonical HTTPS URL where the frontend web application or TMA is hosted.
# Used by the bot server and deep links to launch the web simulator.
# Example: https://clariora.com.au/app or https://comptia-a-plus-master.pages.dev
WEB_APP_URL=

# [REQUIRED] Edge Webhook Secret Token
# High-entropy secret string configured on the Telegram webhook and verified
# by the edge worker on incoming POST requests via X-Telegram-Bot-Api-Secret-Token.
# Protects /api/v1/telegram/webhook from unauthorized spoofed requests.
# Generate using: openssl rand -hex 32
EDGE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 5. Optional AI Coach Model Providers (Configured via wrangler secret put)
# ------------------------------------------------------------------------------
# GROQ_API_KEY=          # Fast free-tier inference (Llama 3.1 8B)
# NVIDIA_API_KEY=        # Enterprise tier inference (Llama 3.1/3.3 70B via NIM)
# OPENROUTER_API_KEY=    # Multi-model inference (Claude 3.5 Sonnet, DeepSeek R1)
# OLLAMA_ENDPOINT=       # Private self-hosted Ollama base URL
# OLLAMA_AUTH_TOKEN=     # Optional bearer token for secured Ollama endpoints
