# ==============================================================================
# Clariora A+ - LOCAL development template
# ==============================================================================
# Copy to .env.local (gitignored). Safe for laptop-only keys and mocks.
# ==============================================================================

APP_ENV=local

# Optional: point at staging worker while developing the client
WEB_APP_URL=http://127.0.0.1:8787

# Local-only admin smoke key (generate: openssl rand -hex 32)
ADMIN_API_KEY=
AUTH_SESSION_SECRET=
FIREBASE_PROJECT_ID=clariora
EDGE_WEBHOOK_SECRET=

# Leave Cloudflare deploy tokens out of .env.local unless you intend to deploy.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
