# ==============================================================================
# Clariora A+ - PRODUCTION environment template
# ==============================================================================
# Copy to .env.production (gitignored). Never commit real values.
# Validate with: node tools/config_validator.js --env-file=.env.production --app-env=production --strict
# ==============================================================================

APP_ENV=production

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=clariora-media

ADMIN_API_KEY=
AUTH_SESSION_SECRET=
FIREBASE_PROJECT_ID=clariora
FIREBASE_WEB_API_KEY=
EDGE_WEBHOOK_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WEB_APP_URL=https://clariora.com.au
WEBHOOK_URL=https://clariora.com.au/api/v1/telegram/webhook

# TON on-chain unlocks (web rail; Stars remain the TMA digital-goods rail)
TON_MERCHANT_WALLET_ADDRESS=
TONCENTER_API_KEY=

