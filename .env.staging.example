# ==============================================================================
# Clariora A+ - STAGING environment template
# ==============================================================================
# Copy to .env.staging (gitignored). Never reuse production secrets here.
# Validate with: node tools/config_validator.js --env-file=.env.staging --app-env=staging
# ==============================================================================

APP_ENV=staging

# Cloudflare (staging-scoped token preferred)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Leave blank or use a non-production zone if you have a staging hostname
CLOUDFLARE_ZONE_ID=

# Isolated R2 / storage (staging bucket only)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=clariora-media-staging

# Admin + edge (staging-only secrets)
ADMIN_API_KEY=
AUTH_SESSION_SECRET=
FIREBASE_PROJECT_ID=clariora
EDGE_WEBHOOK_SECRET=

# Telegram sandbox bot (separate from production @BotFather bot)
TELEGRAM_BOT_TOKEN=
WEB_APP_URL=https://clariora-a-plus-staging.<account>.workers.dev

# Optional AI keys for staging (can be free-tier / rate-limited)
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
