# ---------------------------------------------------------------------------
# Clariora  -  .gitignore
# Rule of thumb: source, generated exam data, and docs are tracked.
# Secrets, build output, and third-party course media are never tracked.
# ---------------------------------------------------------------------------

# Secrets and credentials
.env*
!.env.example
!.env.*.template
.groq_key
**/groq-secrets.local.js
**/groq_secrets.local.json
build/certs/
credentials/
*serviceAccount*.json
serviceAccountKey.json
**/*.pfx
**/*.p12
**/*.jwk
**/*.pem
**/*.key

# Build output and packaged apps
release/
dist/
dist_web/
**/dist/
CompTIA_A_Plus_Desktop_App/**
!CompTIA_A_Plus_Desktop_App/
!CompTIA_A_Plus_Desktop_App/resources/
!CompTIA_A_Plus_Desktop_App/resources/app/
!CompTIA_A_Plus_Desktop_App/resources/app/package.json
node_modules/
.wrangler/
_backup/

# Generated from local media (rebuild with: python tools/build_curriculum.py)
curriculum_data.js
curriculum_data.json

# Third-party course media (not redistributable; kept local only)
Videos For A+/
PowerPoint for A+/
Labs for A+/
CompTIA A+/
media/videos/
media/slides/
media/labs/
*.pdf
*.pptx
*.docx
*.mp4
*.mkv
*.zip

# Scratch dumps from bank authoring sessions
tools/c2_raw_dump.json
tools/group*_raw.txt

# Editor and tooling noise
.pytest_cache/
**/.pytest_cache/
.cursor/
**/.cursor/
.vscode/
.idea/
__pycache__/
*.pyc
*.log
*.log*
firebase-debug*.log
**/coverage/
**/*.tmp
.DS_Store
Thumbs.db
desktop.ini

# Local preview config for AI desktop and agent environments
.claude/
**/.claude/
.agents/
**/.agents/
skills-lock.json

# Generated at build time from icons/icon-512.png
build/icon.png
