{
  "name": "clariora-a-plus",
  "version": "3.1.5",
  "description": "Clariora A+, the CompTIA A+ exam simulator for Core 1 and Core 2",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.datacentreacademy.comptia-a-plus-master",
    "productName": "Clariora",
    "publish": [
      {
        "provider": "generic",
        "url": "https://comptia-a-plus-master.pages.dev/releases/"
      }
    ],
    "files": [
      "**/*",
      "!Videos For A+/**",
      "!media/videos/**",
      "!**/groq-secrets.local.js",
      "!**/groq_secrets.local.json",
      "!credentials/**",
      "!*serviceAccount*.json",
      "!**/*.env*",
      "!admin/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "CompTIA_A_Plus_Setup_${version}.${ext}",
      "legalTrademarks": "Datacentre Academy",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Clariora A+ Simulator",
      "uninstallDisplayName": "Clariora A+ Exam Simulator",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "CompTIA_A_Plus_Portable_${version}.${ext}"
    }
  }
}
