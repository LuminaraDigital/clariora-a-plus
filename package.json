{
  "name": "clariora-a-plus",
  "version": "3.1.5",
  "description": "Clariora A+, the CompTIA A+ exam simulator for Core 1 and Core 2 with Study Library, Ghost Coach, and APX ledger",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js",
    "build:web": "python tools/build_web_dist.py",
    "test:web": "node tools/test_web_dist.js",
    "deploy:cf": "python tools/deploy_cloudflare.py",
    "postinstall": "node tools/cf_workers_ci_build.js",
    "package-win": "python tools/build_windows_installer.py --portable",
    "package-mac": "python3 tools/build_macos_app.py",
    "icons:mac": "python tools/make_macos_icon.py",
    "test": "node tools/run_tests.js",
    "validate:bank": "python tools/validate_bank.py --bank exam_data.json",
    "package-linux": "python3 tools/build_linux_app.py"
  },
  "keywords": [
    "comptia",
    "a-plus",
    "certification",
    "exam-simulator",
    "datacenter",
    "it-support"
  ],
  "author": "Datacentre Academy",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "adm-zip": "^0.6.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.0.12"
  },
  "homepage": "https://github.com/LuminaraDigital/clariora-a-plus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuminaraDigital/clariora-a-plus.git"
  },
  "bugs": {
    "url": "https://github.com/LuminaraDigital/clariora-a-plus/issues"
  }
}
