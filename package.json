{
  "name": "comptia-a-plus-exam-simulator",
  "version": "3.1.0",
  "description": "CompTIA A+ Master Exam Simulator for Core 1 and Core 2 with Study Library, Ghost Coach, and APX ledger",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js",
    "package-win": "python tools/build_windows_installer.py --portable",
    "package-mac": "python3 tools/build_macos_app.py",
    "icons:mac": "python tools/make_macos_icon.py",
    "test": "node tools/run_tests.js",
    "validate:bank": "python tools/validate_bank.py --bank exam_data.json"
  },
  "keywords": [
    "comptia",
    "a-plus",
    "certification",
    "exam-simulator",
    "datacenter",
    "it-support"
  ],
  "author": "Datacentre Academy",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.1.1"
  },
  "homepage": "https://github.com/LuminaraDigital/comptia-a-plus-master#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuminaraDigital/comptia-a-plus-master.git"
  },
  "bugs": {
    "url": "https://github.com/LuminaraDigital/comptia-a-plus-master/issues"
  }
}
